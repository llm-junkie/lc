{
  "name": "VS Light",
  "version": 1,
  "mode": "spine",
  "base": "light",
  "codeTheme": "github",
  "spine": {
    "--bg": "#e4e4e8",
    "--bg-elev-1": "#ededf2",
    "--bg-elev-2": "#f5f5f9",
    "--bg-elev-3": "#fbfbff",
    "--accent": "#60c0ff",
    "--text": "#18181b",
    "--text-muted": "#5e5e67",
    "--text-faint": "#8a8a93",
    "--border": "#d6d6d6",
    "--border-strong": "#c3c3c3",
    "--accent-hover": "#9bdeff",
    "--accent-soft": "rgba(96, 192, 255, 0.16)",
    "--user-bubble-gradient": "linear-gradient(135deg, rgba(96, 192, 255, 0.18) 0%, rgba(96, 192, 255, 0.12) 100%)",
    "--user-bubble-border": "rgba(180, 239, 254, 0.16)",
    "--code-block-bg": "#f8f8f8",
    "--code-block-fg": "#333333"
  }
