# =============================================================================
#  LC — Web client  (web/.gitignore)
# =============================================================================
# This file treats the `web/` folder as its own self-contained repository.
# Scope: only patterns that affect files inside this directory.
#
# Companion: the repo-root `.gitignore` covers the wider monorepo
# (Android, etc.) and also has a `web/*` section that mirrors most of
# this. When you copy `web/` to a standalone repo, this file is the
# one that travels with it.
# =============================================================================


# -----------------------------------------------------------------------------
#  Dependencies / package managers
# -----------------------------------------------------------------------------
# npm
node_modules/
.npm/
.npmrc.local

# pnpm
.pnpm-store/
.pnpm-debug.log*

# yarn (classic + berry)
.yarn/
.yarn-cache/
.yarn/install-state.gz
.yarn/.gitignore
.pnp.*

# bun
bun.lockb

# -----------------------------------------------------------------------------
#  Build output
# -----------------------------------------------------------------------------
# INVARIANT: everything `clean.cmd` / `clean.sh` deletes must be ignored here.
# Those scripts define what is disposable; if a path is disposable it must never
# be committed. When you add a target to clean, add it here in the same change.

# Vite
dist/
dist-ssr/
dist-portable/
release/
.vite/
.vite-temp/
*.local
*.tsbuildinfo

# Excalidraw fonts — copied from node_modules at build time (see scripts/copy-excalidraw-assets.mjs)
public/excalidraw-assets/

# Tauri resources generated at build time (see scripts/copy-tauri-resources.mjs)
#
# public/models-cache.json is TRACKED, not generated. It is the compact
# catalogue the app loads at runtime and the Tauri build stages, so the build
# stays offline and two builds of one commit produce the same bytes. Refresh it
# deliberately — scripts/fetch-models-dev.mjs then scripts/build-models-cache.mjs
# — and commit the result. The 3 MB models.dev snapshot it derives from is not
# tracked; only the 390 KB output is.
scripts/data/models-dev.json
src-tauri/resources/models-cache.json
src-tauri/resources/models-dev.json
src-tauri/resources/spine-builder.html
src-tauri/resources/LICENSE
src-tauri/resources/NOTICE
src-tauri/resources/THIRD_PARTY_LICENSES.md

# Generated license inventories are production artifacts, never source.
# The root/legal patterns also suppress obsolete outputs from older scripts.
/THIRD_PARTY_LICENSES.md
/legal/EXCALIDRAW_FONTS_LICENSES.md

# Parcel / webpack / general
.cache/
.parcel-cache/
.turbo/
.webpack/

# Nuxt / Next / SvelteKit — not used here, kept for safety
.nuxt/
.next/
.svelte-kit/

# Build artefacts
build/
out/
*.tgz
*.tar.gz

# -----------------------------------------------------------------------------
#  Tauri / Rust  (src-tauri/)
# -----------------------------------------------------------------------------
# Rust build outputs
src-tauri/target/

# Transient `cargo check` output redirected to a file
src-tauri/cargo_check.txt

# Cargo.lock is INTENTIONALLY NOT ignored. This is a binary project
# (the Tauri desktop shell), and committing Cargo.lock is the standard
# recommendation for reproducible application builds. (For libraries
# the recommendation is the opposite — they'd ignore it.)

# Tauri auto-generated artefacts (regenerated by `tauri build`)
src-tauri/gen/
src-tauri/gen/schemas/

# Tauri 2 Windows installer tools cache (auto-downloaded, not source)
src-tauri/WixTools/

# -----------------------------------------------------------------------------
#  Logs  (including the `.dev-*.log` artefacts `npm run dev` produces)
# -----------------------------------------------------------------------------
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*
.dev-*.log
.dev-*.out


# -----------------------------------------------------------------------------
#  Web dev / build session artefacts
# -----------------------------------------------------------------------------
# These show up in `web/` root after running dev/build commands
# (`npm run dev`, `npm run tauri:dev`, `npm run tauri:build`, etc.)
# and from MCP-tool helpers (image generation drops `matrix-media-*`
# PNGs in the cwd). None of it is source — safe to delete.

# Generic dot-prefixed dev/build artefacts
.build-*.log
.build-*.out
.tauri-*.log
.tauri-*.out
.icons-*.log
.icons-*.out
.preview-*.png
.preview-*.jpg
.preview-*.svg
.dev-*.log
.dev-*.out

# Specific named log files (broader catch-all for sibling artefacts)
build.log
build.out
tauri-build.log
tauri-build.out
vite-dev.log
vite-dev.out

# MCP-tool generated media (image generation drops these in the cwd)
matrix-media-*.png
matrix-media-*.jpg
matrix-media-*.webp

# Built portable/installer artefacts that some `tauri build` workflows
# drop in `web/` root (the actual installer bundles in
# `src-tauri/target/release/bundle/` are already covered by the
# `src-tauri/target/` rule above). Match the exact name pattern so we
# don't accidentally swallow legitimate source zips.
*-portable.zip
*_portable.zip
LLM-Client_*.zip
LLM-Client_*.msi
LLM-Client_*.dmg
LLM-Client_*.AppImage
LLM-Client_*.deb
LLM-Client_*.exe

# Stray archive / backup drops at any depth (e.g. `src.rar`,
# `src_01.rar` backups). The build pipeline never produces these
# formats, so a RAR or 7z anywhere in the tree is a user-created
# backup that shouldn't be committed.
*.rar
*.7z
*.7z.sha256

# -----------------------------------------------------------------------------
#  Environment / secrets  (NEVER commit)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Generic secrets
*.pem
*.key
*.p12
*.pfx
secrets/
api-keys.txt

# -----------------------------------------------------------------------------
#  Tests / coverage
# -----------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
htmlcov/
junit.xml
test-results/
playwright-report/
playwright/.cache/

# -----------------------------------------------------------------------------
#  Lint / formatter caches
# -----------------------------------------------------------------------------
.eslintcache
.stylelintcache
.prettiercache

# -----------------------------------------------------------------------------
