.DS_Store
.DS_Store?
._*
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk
Desktop.ini

# Linux
.nfs*

# -----------------------------------------------------------------------------
#  Editors / IDEs
# -----------------------------------------------------------------------------
# IntelliJ / WebStorm
.idea/
*.iml
*.ipr
*.iws

# VS Code — keep the team's shared settings files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Claude Code — per-machine agent scratch (launch.json for the dev-server
# preview, local settings). `CLAUDE.md` at the repo root is source and stays
# tracked; nothing under `.claude/` is.
.claude/

# Eclipse / NetBeans
.project
.classpath
.settings/
.factorypath
nbproject/
nb-configuration.xml

# Sublime / vim / emacs
*.swp
*.swo
*~
.*.sw[a-p]
*.[a-z]~

# JetBrains Rider
.idea_modules/
.idea/httpRequests

# Misc
.history/
*.code-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -----------------------------------------------------------------------------
#  Misc / temp
# -----------------------------------------------------------------------------
.tmp/
.tmp.*
*.tmp
*.bak
*.orig
*.rej
tmp/
temp/

# Snapshots / visual diffs
*.snap

# Note: `*.zip` is intentionally NOT in this web-scoped gitignore. The
# section above ("Built portable/installer artefacts") lists the
# specific LLM-Client artefact names. If you ever need to ignore a
# different .zip for a non-build reason, scope it tightly (e.g. a
# specific directory) so the LLM-Client build doesn't get caught.

# -----------------------------------------------------------------------------
#  7z LC test fixtures (scripts/fixtures/)
# -----------------------------------------------------------------------------
# The `.7z` files under scripts/fixtures/ are COMMITTED test fixtures — 7-Zip
# recompressions of real conversation exports and support reports. Tests
# extract them on demand,
# each into its own subdir named after the archive
# (scripts/fixture-lc-archives.mjs); those extracted copies are
# disposable and must never be committed. These entries must stay after the
# generic `*.7z` rule above — last match wins.
scripts/fixtures/*/
!scripts/fixtures/*.7z
!scripts/fixtures/docs-sync-check/
